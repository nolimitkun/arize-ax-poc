# ---- Arize AX ----------------------------------------------------------
# Space Settings -> API Keys.  https://app.arize.com
ARIZE_API_KEY=
ARIZE_SPACE_ID=
# The human-readable space name. Platform-API calls (datasets, evaluators,
# prompts) take `space=`; the OTel exporter takes `space_id=`. You need both.
ARIZE_SPACE_NAME=

# The tracing project. Change this to start a clean run of the tour.
ARIZE_PROJECT_NAME=nimbus-support-copilot

# Your space's region. Leave blank for the US default. Arize keys are
# region-scoped, and a key used against the wrong region fails to authorize
# rather than redirecting -- on the exporter that reads
# "unable to validate authorization from span".
# One setting drives both the trace collector URL and the platform client.
# Values: eu-west-1a | ca-central-1a | us-central-1a | us-east-1b
ARIZE_REGION=

# ---- DeepSeek ----------------------------------------------------------
# https://platform.deepseek.com -> API keys
DEEPSEEK_API_KEY=

# ---- Optional ----------------------------------------------------------
# DeepSeek speaks the OpenAI protocol, so everything goes through the `openai`
# SDK pointed here. Override only for a proxy or a self-hosted deployment.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# The V4 line: deepseek-v4-pro (1.6T/49B) and deepseek-v4-flash (284B/13B).
# The agent runs pro, the intent router runs flash. Point the agent at flash to
# see a cheaper model's failure rate side by side in an AX experiment.
# The deepseek-chat / deepseek-reasoner aliases were retired on 2026-07-24.
# COPILOT_AGENT_MODEL=deepseek-v4-pro
# COPILOT_ROUTER_MODEL=deepseek-v4-flash

# Needed only by poc/05 (online LLM-as-judge). This is a model provider
# configured *inside* Arize (Space Settings -> Integrations), NOT your
# DEEPSEEK_API_KEY. Leave blank and 05 will look it up, or create it for you
# with `--create-integration`.
ARIZE_AI_INTEGRATION_ID=

# Which prompt version the agent runs. "v1" is the deliberately-flawed
# baseline; "v2" is the fix; "hub" loads the `production` label from
# Arize Prompt Hub (see poc/09).
COPILOT_PROMPT_VERSION=v1

# Which engine runs the copilot. "sdk" is the hand-written tool loop over the
# raw openai SDK; "langgraph" is the same copilot as a LangGraph/LangChain
# graph, traced by LangChainInstrumentor and written to its own project
# ($ARIZE_PROJECT_NAME-lg). Same prompts, tools, corpus, and seeded failures
# either way -- see "Second engine: LangGraph" in the README.
# COPILOT_IMPL=sdk
